{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "SHOWSTACK_SITE=\"https://$VERCEL_PROJECT_PRODUCTION_URL\" SHOWSTACK_REPO=\"deliseph/showstack\" node scripts/validate.mjs && SHOWSTACK_SITE=\"https://$VERCEL_PROJECT_PRODUCTION_URL\" SHOWSTACK_REPO=\"deliseph/showstack\" node scripts/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/showstack.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "cleanUrls": true
}
