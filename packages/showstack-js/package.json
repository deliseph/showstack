    "psn", "posistagenet", "timecode", "esta", "rigging", "av"
  ],
  "repository": { "type": "git", "url": "git+https://github.com/OWNER/showstack.git" },
  "homepage": "https://github.com/OWNER/showstack#readme",
  "bugs": { "url": "https://github.com/OWNER/showstack/issues" },
  "license": "MIT",
  "sideEffects": false
}
