{
  "name": "showstack",
  "version": "0.1.0",
  "description": "The open index of live entertainment technology: protocols, standards, software, hardware and bilingual vocabulary, with a citation on every fact.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./data": "./showstack.json"
